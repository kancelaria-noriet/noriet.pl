---json
{
  "layout": "layouts/base.njk",
  "title": "Oferta",
  "titleTag": "Oferta | Noriet",
  "description": "Zakres usług Kancelarii Prawnej Noriet: obsługa firm, prawo rodzinne i rozwody, majątek i spadki, prawa pracownika.",
  "permalink": "/oferta/",
  "h1": "Oferta"
}
---
<div class="crumb-band">
  <div class="wrap">
    {% include "partials/breadcrumb.njk" %}
  </div>
</div>
<header class="service-hero service-hero--center">
  <div class="wrap">
    <p class="kicker">Zakres praktyki</p>
    <h1>Oferta</h1>
    <p class="service-hero__lead">Obszary, w których prowadzimy sprawy na co
    dzień. Każdą sprawę prowadzi wyznaczony adwokat lub radca prawny, od
    pierwszej rozmowy do prawomocnego zakończenia.</p>
    <p class="hero__actions">
      <a class="btn btn--call" href="{{ site.phoneHref }}">Zadzwoń: {{ site.phone }}</a>
      <a class="btn btn--ghost" href="/konsultacje/">Umów konsultację</a>
    </p>
  </div>
</header>
<div class="wrap">
  {# Every category from nav.categories, with its complete service list. The
     homepage renders the same array; only this page carries the descriptions. #}
  {% for cat in nav.categories %}
  <section class="practice-row" aria-labelledby="cat-{{ cat.slug }}">
    <div>
      <h2 id="cat-{{ cat.slug }}"><a href="{{ cat.url }}">{{ cat.label }}</a></h2>
      <p class="practice-row__summary">{{ cat.summary }}</p>
    </div>
    <div class="practice-row__body">
      {% if cat.services.length %}
      <ul class="offer-list">
        {% for s in cat.services %}
        <li><a href="{{ s.url }}">{{ s.label }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </section>
  {% endfor %}
</div>
