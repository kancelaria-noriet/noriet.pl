---
layout: layouts/base.njk
crumbParent:
  label: Konsultacje
  url: /konsultacje/
---
<div class="crumb-band">
  <div class="wrap">
    {% include "partials/breadcrumb.njk" %}
  </div>
</div>
{# The old site earned "product snippet" impressions in GSC; Service + Offer
   keeps that appearance. Prices are gross PLN, parsed from the price field. #}
{% set pp = price | priceParts %}
{% set svcLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": h1 or title,
  "url": site.url + page.url,
  "provider": { "@id": site.url + "/#kancelaria" }
} %}
{% if subtitle %}{% set svcLd = svcLd | setAttribute("description", subtitle) %}{% endif %}
{% if pp.num %}{% set svcLd = svcLd | setAttribute("offers", {
  "@type": "Offer",
  "price": pp.num | replace(" ", ""),
  "priceCurrency": "PLN",
  "url": site.url + page.url
}) %}{% endif %}
<script type="application/ld+json">{{ svcLd | dump | safe }}</script>
<div class="wrap page-top">
  <article class="service">
    <header class="service__header">
      <h1>{{ h1 or title }}</h1>
      {% if subtitle %}<p class="product__subtitle">{{ subtitle }}</p>{% endif %}
      {% if price %}<p class="product__price">{{ price }}</p>{% endif %}
    </header>
    <div class="prose">
      {{ content | safe }}
    </div>
    <p class="cta-band__actions">
      {% if paymentLink %}<a class="btn btn--call" href="{{ paymentLink }}" rel="nofollow">{{ paymentLabel or "Kup usługę" }}</a>{% endif %}
      <a class="btn btn--ghost" href="{{ site.phoneHref }}" data-umami-event="telefon">Zadzwoń: {{ site.phone }}</a>
    </p>
  </article>
</div>
