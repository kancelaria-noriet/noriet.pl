---
layout: layouts/base.njk
crumbParent:
  label: Konsultacje
  url: /konsultacje/
---
<div class="crumb-band">
  <div class="wrap">
    {% include "partials/breadcrumb.njk" %}
  </div>
</div>
{# Service + Offer: correct semantics for a paid legal service, feeds the AEO
   surfaces (twins, llms.txt). It earns NO Google rich result — only @type
   Product does, and the old site never emitted Product markup (capture
   verified 2026-09-07, review02 #18; an earlier comment here claimed GSC
   product-snippet impressions that cannot have existed). Converting to
   Product to chase price snippets is a recorded future option: PLAN Phase 6.
   Prices are gross PLN, parsed from the price field. #}
{% set pp = price | priceParts %}
{% set svcLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": h1 or title,
  "url": site.url + page.url,
  "provider": { "@id": site.url + "/#kancelaria" }
} %}
{% if subtitle %}{% set svcLd = svcLd | setAttribute("description", subtitle) %}{% endif %}
{% if pp.num %}{% set _offer = {
  "@type": "Offer",
  "price": pp.num | replace(" ", ""),
  "priceCurrency": "PLN",
  "url": site.url + page.url
} %}
{# A periodic price (the trial month) must not read as the total engagement
   price: priceUnit (UN/ECE code, e.g. MON) turns it into a per-unit spec. #}
{% if priceUnit %}{% set _offer = _offer | setAttribute("priceSpecification", {
  "@type": "UnitPriceSpecification",
  "price": pp.num | replace(" ", ""),
  "priceCurrency": "PLN",
  "unitCode": priceUnit
}) %}{% endif %}
{% set svcLd = svcLd | setAttribute("offers", _offer) %}{% endif %}
{% set svcLd = svcLd | setAttribute("areaServed", none | jsonldAreaServed) %}
{% set svcLd = svcLd | setAttribute("serviceType", "Konsultacja prawna") %}
<script type="application/ld+json">{{ svcLd | dump | safe }}</script>
<div class="wrap page-top">
  <article class="service">
    <header class="service__header">
      <h1>{{ h1 or title }}</h1>
      {% if subtitle %}<p class="product__subtitle">{{ subtitle }}</p>{% endif %}
      {% if price %}<p class="product__price">{{ price }}</p>{% endif %}
    </header>
    <div class="prose">
      {{ content | safe }}
    </div>
    <p class="cta-band__actions">
      {% if paymentLink %}<a class="btn btn--call" href="{{ paymentLink }}" rel="nofollow">{{ paymentLabel or "Kup usługę" }}</a>{% endif %}
      <a class="btn btn--ghost" href="{{ site.phoneHref }}" data-umami-event="telefon">Zadzwoń: {{ site.phone }}</a>
    </p>
  </article>
</div>
