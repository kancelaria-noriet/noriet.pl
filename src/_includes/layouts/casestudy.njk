---
layout: layouts/base.njk
crumbParent:
  label: Publikacje
  url: /publikacje/
---
<div class="wrap">
  {% include "partials/breadcrumb.njk" %}
  <div class="rail-layout">
    <article class="service">
      <header class="service__header">
        <p class="kicker">Publikacja</p>
        <h1>{{ h1 or title }}</h1>
        {% if isbn or wydawnictwo or dataWydania %}
        <p class="article-meta">
          {% if wydawnictwo %}{{ wydawnictwo }}{% endif %}
          {% if dataWydania %} · {{ dataWydania }}{% endif %}
          {% if isbn %} · ISBN {{ isbn }}{% endif %}
        </p>
        {% endif %}
      </header>
      <div class="prose">
        {{ content | safe }}
      </div>
      <aside class="cta-card" aria-label="Kontakt w sprawie">
        <h2>Potrzebujesz opinii w podobnej sprawie?</h2>
        <p>Przygotowujemy opinie prawne i komentarze na zlecenie. Zadzwoń
        lub napisz.</p>
        <p class="cta-band__actions">
          <a class="btn btn--call" href="{{ site.phoneHref }}">{{ site.phone }}</a>
          <a class="btn btn--ghost" href="/kontakt/">Napisz do nas</a>
        </p>
      </aside>
    </article>
    <aside class="rail">
      {% if dodatkowePola and dodatkowePola.length %}
      <div class="rail-card">
        <h2 class="rail-card__heading">Dane publikacji</h2>
        <dl class="kv kv--caps">
          {% for pole in dodatkowePola %}
          <dt>{{ pole.tytul }}</dt><dd>{{ pole.tresc | safe }}</dd>
          {% endfor %}
        </dl>
        {% if pubLink %}<p><a class="more" href="{{ pubLink }}" rel="nofollow">Zobacz publikację →</a></p>{% endif %}
      </div>
      {% endif %}
      <div class="rail-card">
        <h2 class="rail-card__title">Publikacje i case studies</h2>
        <p>Komentarze, opinie i opisy prowadzonych spraw — pełne archiwum.</p>
        <p><a class="more" href="/publikacje/">Zobacz wszystkie →</a></p>
      </div>
    </aside>
  </div>
</div>
