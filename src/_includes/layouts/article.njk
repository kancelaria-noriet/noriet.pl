---
layout: layouts/base.njk
---
{% set cat = postCategories.categories | categoryOf(postCategories.bySlug, page.fileSlug) %}
{% set crumbs = [{ label: "Blog", url: "/blog/" }] %}
{% if cat %}{% set crumbs = [{ label: "Blog", url: "/blog/" }, { label: cat.label, url: "/blog/kategoria/" + cat.slug + "/" }] %}{% endif %}
<div class="crumb-band">
  <div class="wrap">
    {% include "partials/breadcrumb.njk" %}
  </div>
</div>
{# datePublished stays the original day. dateModified is the last real
   update, or the publish day when the post has not been rewritten. #}
{% set _ldImg = content | firstImg %}
<script type="application/ld+json">{{ {
  "headline": h1 or title,
  "datePublished": isoDate,
  "dateModified": isoModified or isoDate,
  "description": description,
  "url": page.url,
  "section": cat.label if cat else none,
  "image": _ldImg,
  "authors": authors
} | jsonldArticle(site) | safe }}</script>
<div class="wrap">
  <div class="rail-layout">
    <article class="service">
      <header class="service__header">
        {% set kicker = (h1 or title) | series %}
        {% if kicker %}<p class="kicker">{{ kicker }}</p>{% endif %}
        <h1>{{ h1 or title }}</h1>
        {% if freshDisplay or displayDate %}
        <p class="article-meta">
          <time datetime="{{ freshIso or isoDate }}">Ostatnia aktualizacja: {{ freshDisplay or displayDate }}</time>
          · {{ content | readingTime }}
          {% if cat %}· <a href="/blog/kategoria/{{ cat.slug }}/">{{ cat.label }}</a>{% endif %}
        </p>
        {% endif %}
      </header>
      {% set split = content | summarySplit %}
      {% if split.summary %}
      <aside class="summary-box" aria-label="W skrócie">
        <p class="rail-card__title">W skrócie</p>
        {{ split.summary | safe }}
      </aside>
      {% endif %}
      <div class="prose">
        {{ split.rest | stripByline | safe }}
        {% if authors and authors.length %}
        <p class="article-byline">{{ authors | authorBylineHtml | safe }}</p>
        {% endif %}
      </div>
      <aside class="cta-card" aria-label="Kontakt w sprawie">
        <h2>Masz podobną sprawę?</h2>
        <p>Omówimy Twoją sytuację i realne terminy podczas konsultacji.</p>
        <p class="cta-band__actions">
          <a class="btn btn--call" href="{{ site.phoneHref }}" data-umami-event="telefon">{{ site.phone }}</a>
          <a class="btn btn--ghost" href="/konsultacje/">Konsultacje</a>
          <a class="btn btn--ghost" href="/kontakt/">Napisz do nas</a>
        </p>
      </aside>
    </article>
    <aside class="rail">
      {% if cat %}
      {# Siblings first: a reader who got here from a search is far likelier to
         want the next article on the same topic than the newest one overall. #}
      <div class="rail-card">
        <h2 class="rail-card__title">Więcej w kategorii</h2>
        <p class="rail-card__lead">{{ cat.label }}</p>
        <ul class="rail-list">
          {% for post in collections.post | inCategory(postCategories.bySlug, cat.slug) | byFreshness | reverse | excludeUrl(page.url) | limit(4) %}
          <li>
            <a href="{{ post.url }}">{{ post.data.h1 or post.data.title }}</a>
            <span class="rail-list__meta">{{ post.data.freshDisplay }}</span>
          </li>
          {% endfor %}
        </ul>
        <p><a class="more" href="/blog/kategoria/{{ cat.slug }}/">Cała kategoria</a></p>
      </div>
      {% endif %}
      <div class="rail-card">
        <h2 class="rail-card__title">Ostatnie artykuły</h2>
        <ul class="rail-list">
          {% for post in collections.post | byFreshness | reverse | excludeUrl(page.url) | limit(3) %}
          <li>
            <a href="{{ post.url }}">{{ post.data.h1 or post.data.title }}</a>
            <span class="rail-list__meta">{{ post.data.freshDisplay }}</span>
          </li>
          {% endfor %}
        </ul>
        <p><a class="more" href="/blog/wszystkie-artykuly/">Spis wszystkich artykułów</a></p>
      </div>
    </aside>
  </div>
</div>
