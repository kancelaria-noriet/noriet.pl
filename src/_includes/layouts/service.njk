---
layout: layouts/base.njk
---
{% set slug = page.fileSlug %}
{% set meta = serviceMeta.bySlug[slug] %}
{# One service belongs to one category (nav.categories). A page whose url equals
   its category's url is that category's hub: it lists the whole category under
   the hero. Every other page links back up and shows its siblings instead. #}
{% set cat = null %}
{% if meta %}{% for c in nav.categories %}{% if c.slug == meta.category %}{% set cat = c %}{% endif %}{% endfor %}{% endif %}
{% set isHub = cat and cat.url == page.url %}
{# The breadcrumb parent follows the offer taxonomy, so derive it from
   serviceMeta rather than defaulting it in the front matter. /akcjonariusze/
   and /obligacje/ borrow this layout but are not services, and a null in
   their own front matter cannot switch a layout default off: Eleventy's
   merge treats a falsy page value as absent and the layout wins. #}
{% set crumbParent = { label: "Oferta", url: "/oferta/" } if meta else null %}
<div class="crumb-band">
  <div class="wrap">
    {% include "partials/breadcrumb.njk" %}
  </div>
</div>

<div class="wrap">
  <header class="service-hero">
    {% if meta %}<p class="kicker">{{ meta.kicker }}</p>{% endif %}
    <h1>{{ h1 or title }}</h1>
    {# `lead` when the hero sentence is longer than a meta description should be;
       `description` alone still works for the pages that share one string. #}
    {% set heroLead = lead or description %}
    {% if heroLead %}<p class="service-hero__lead">{{ heroLead }}</p>{% endif %}
    <ul class="chips" aria-label="Kancelaria">
      <li>Adwokaci i radcowie prawni</li>
      <li>Izba Adwokacka w Warszawie · OIRP</li>
      <li>Dwoje mediatorów certyfikowanych</li>
    </ul>
    <p class="hero__actions">
      <a class="btn btn--call" href="{{ site.phoneHref }}">Zadzwoń: {{ site.phone }}</a>
      <a class="btn btn--ghost" href="/kontakt/">Opisz sprawę</a>
    </p>
  </header>

  {% if isHub %}{% include "partials/category-services.njk" %}{% endif %}

  {% set tocItems = content | toc %}
  <div class="service-layout">
    <article class="service">
      <div class="prose">
        {{ content | safe }}
      </div>
      {% if cat and not isHub %}
      <nav class="related" aria-label="Powiązane obszary praktyki">
        <h2>Więcej w kategorii <a href="{{ cat.url }}">{{ cat.label }}</a></h2>
        <ul>
          {% for item in cat.services %}
          {% if item.url != page.url %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endif %}
          {% endfor %}
        </ul>
      </nav>
      {% endif %}
    </article>

    <aside class="rail">
      {% if tocItems.length > 1 %}
      <nav class="rail-card toc-card" aria-label="Spis treści">
        <h2 class="rail-card__title">Na tej stronie</h2>
        <ol>
          {% for item in tocItems %}
          <li><a href="#{{ item.id }}">{{ item.text }}</a></li>
          {% endfor %}
        </ol>
      </nav>
      {% endif %}

      {% if meta %}
      {% set lawyer = null %}
      {% for person in collections.team %}
      {% if not lawyer and meta.lawyerMatch in (person.data.specjalizacja | lower) %}{% set lawyer = person %}{% endif %}
      {% endfor %}
      {% if lawyer %}
      <div class="rail-card lawyer-card">
        <h2 class="rail-card__title">Prowadzi te sprawy</h2>
        <div class="lawyer-card__row">
          {% if lawyer.data.photo %}<img src="{{ lawyer.data.photo }}" alt="{{ lawyer.data.h1 }}"{% if lawyer.data.photoW %} width="{{ lawyer.data.photoW }}" height="{{ lawyer.data.photoH }}"{% endif %} loading="lazy">{% endif %}
          <div>
            <p class="lawyer-card__name">{{ lawyer.data.h1 }}</p>
            <p class="lawyer-card__role">{{ lawyer.data.rola }}</p>
            <p class="lawyer-card__spec">{{ lawyer.data.specjalizacja }}</p>
          </div>
        </div>
        <p><a class="more" href="{{ lawyer.url }}">Pełny profil i doświadczenie →</a></p>
      </div>
      {% endif %}
      {% endif %}

      {% set upsell = null %}
      {% for k in collections.konsultacja %}
      {% if not upsell and k.data.h1 == serviceMeta.upsellTitle %}{% set upsell = k %}{% endif %}
      {% endfor %}
      {% if upsell %}
      <div class="rail-card upsell-card">
        <h2 class="upsell-card__title">{{ upsell.data.h1 }}</h2>
        {% if upsell.data.subtitle %}<p class="product__subtitle">{{ upsell.data.subtitle }}</p>{% endif %}
        {% set pp = upsell.data.price | priceParts %}
        <p class="upsell-card__price">{{ pp.num }}{% if pp.unit %} <small>{{ pp.unit }}</small>{% endif %}</p>
        <p><a class="btn btn--call btn--block" href="{{ upsell.url }}">Kup usługę</a></p>
        <p><a class="more" href="/konsultacje/">Wszystkie konsultacje i ceny →</a></p>
      </div>
      {% endif %}
    </aside>
  </div>
</div>

{% if relatedPosts and relatedPosts.length %}
<section class="band" aria-labelledby="sprawdz-title">
  <div class="wrap">
    <h2 id="sprawdz-title">Sprawdź również</h2>
    <div class="list-grid">
      {% for rel in relatedPosts %}
      {% if rel.url != page.url %}
      <article class="list-card">
        <h3><a href="{{ rel.url }}">{{ rel.title }}</a></h3>
        {% if rel.date %}<time>{{ rel.date }}</time>{% endif %}
        {% if rel.excerpt %}<p>{{ rel.excerpt }}</p>{% endif %}
        <p><a class="more" href="{{ rel.url }}">czytaj więcej →</a></p>
      </article>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="form-section form-section--rule" aria-labelledby="sprawa-title">
  <div class="wrap">
    <h2 id="sprawa-title">Opisz swoją sprawę</h2>
    <p class="section-lead">Odpowiadamy w ciągu jednego dnia roboczego. Jeśli
    sprawa jest pilna — zadzwoń pod <a href="{{ site.phoneHref }}">{{ site.phone }}</a>.</p>
    <div class="rail-layout">
      {% include "partials/form-contact.njk" %}
      {% include "partials/kancelaria-card.njk" %}
    </div>
  </div>
</section>
