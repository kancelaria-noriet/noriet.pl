{# Blog taxonomy rail card. Set `activeCat` before the include to mark the
   current category; the count comes from the live collection, never from a
   number stored in the data file.

   It is a <details> that ships OPEN. On a phone the rail stacks under the
   article list, so assets/js/nav.js closes it below the two-column breakpoint
   and the reader meets the categories instead of scrolling 3 000 px past them.
   Shipping it open means no-JS visitors and crawlers always get the ten links,
   and the links are in the DOM either way. #}
<details class="rail-card cat-card" open>
  <summary class="cat-card__summary">
    <h2 class="rail-card__title">Kategorie</h2>
  </summary>
  <ul class="cat-list">
    {% for cat in postCategories.categories %}
    <li>
      {% if cat.slug == activeCat %}
      <span class="cat-list__current" aria-current="true">{{ cat.label }}</span>
      {% else %}
      <a href="/blog/kategoria/{{ cat.slug }}/">{{ cat.label }}</a>
      {% endif %}
      <span class="cat-list__count">{{ collections.post | inCategory(postCategories.bySlug, cat.slug) | length }}</span>
    </li>
    {% endfor %}
  </ul>
  <p><a class="more" href="/blog/wszystkie-artykuly/">Spis wszystkich {{ collections.post | length }} artykułów →</a></p>
</details>
