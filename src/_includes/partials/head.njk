<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if titleTag %}{{ titleTag }}{% else %}{{ title }} | {{ site.shortName }}{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if robots %}<meta name="robots" content="{{ robots }}">
  {% elif buildEnv != "production" %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% set _mdTwin = page.url | mdTwin %}
  {% if _mdTwin %}<link rel="alternate" type="text/markdown" href="{{ _mdTwin }}">{% endif %}
  <meta property="og:site_name" content="{{ site.shortName }}">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:type" content="{{ "article" if tags and "post" in tags else "website" }}">
  <meta property="og:title" content="{% if titleTag %}{{ titleTag }}{% else %}{{ title }}{% endif %}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {# One default social image; a page overrides it with `ogImage` (absolute path).
     Team bios pass their portrait. #}
  {% set _og = ogImage or photo or "/assets/img/og-default.png" %}
  <meta property="og:image" content="{{ site.url }}{{ _og }}">
  {% if not ogImage %}<meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">{% endif %}
  <meta name="twitter:card" content="{{ "summary" if (ogImage or photo) else "summary_large_image" }}">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#0c1e37">
  <link rel="manifest" href="/site.webmanifest">
  <script src="/assets/js/theme-init.js"></script>
  {# Self-hosted Umami, proxied first-party: the script at /v posts to /e/api/info,
     both served by functions/ on this origin. Cookieless (D2), so no consent
     banner. The website id is public. #}
  {% if site.umamiWebsiteId %}<script defer src="/v" data-website-id="{{ site.umamiWebsiteId }}"></script>{% endif %}
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/main.css">
  <meta name="theme-color" content="#081830">
  {% include "partials/jsonld-org.njk" %}
</head>
