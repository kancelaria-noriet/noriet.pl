<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if titleTag %}{{ titleTag }}{% else %}{{ title }} | {{ site.shortName }}{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if robots %}<meta name="robots" content="{{ robots }}">
  {% elif buildEnv == "development" %}<meta name="robots" content="noindex, nofollow">
  {# Production default: large image previews in Discover and image results,
     as the old site sent on every page (review03 #28). #}
  {% else %}<meta name="robots" content="max-image-preview:large">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% set _mdTwin = page.url | mdTwin %}
  {% if _mdTwin %}<link rel="alternate" type="text/markdown" href="{{ _mdTwin }}">{% endif %}
  <link rel="alternate" type="application/rss+xml" title="{{ site.shortName }} – blog" href="/feed.xml">
  {% if authors and authors.length %}<meta name="author" content="{{ authors | authorNames }}">{% endif %}
  <meta property="og:site_name" content="{{ site.shortName }}">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:type" content="{{ "article" if tags and "post" in tags else "website" }}">
  <meta property="og:title" content="{% if titleTag %}{{ titleTag }}{% else %}{{ title }}{% endif %}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {# One default social image; a page overrides it with `ogImage` (absolute path).
     Team bios pass their portrait. #}
  {% set _og = ogImage or photo or "/assets/img/og-default.png" %}
  <meta property="og:image" content="{{ site.url }}{{ _og }}">
  {# Dimensions must describe the image actually sent: the portrait's own
     size on team bios, 1200x630 for the default card, none for an ogImage
     override (unknown). Square portraits get the small twitter card. #}
  {% if ogImage %}{% elif photo and photoW %}<meta property="og:image:width" content="{{ photoW }}">
  <meta property="og:image:height" content="{{ photoH }}">
  {% elif not photo %}<meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">{% endif %}
  <meta name="twitter:card" content="{{ "summary" if (photo and not ogImage) else "summary_large_image" }}">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#0c1e37">
  <link rel="manifest" href="/site.webmanifest">
  {# Inlined theme script (owner call, 2026-09-07) — the one deliberate
     exception to "no inline JS": deferred would flash the wrong theme, and a
     separate blocking request cost ~500 ms of mobile first paint (PSI lab). #}
  <script>{% include "js/theme-init.js" %}</script>
  {# Self-hosted Umami, proxied first-party: the script at /v posts to /e/api/info,
     both served by functions/ on this origin. Cookieless (D2), so no consent
     banner. The website id is public. #}
  {# Production builds pin the tracker to the live hostname, so the preview
     records nothing (its test rows were a manual purge at launch before). #}
  {% if site.umamiWebsiteId %}<script defer src="/v" data-website-id="{{ site.umamiWebsiteId }}"{% if buildEnv != "development" %} data-domains="{{ site.url | replace("https://", "") }}"{% endif %}></script>{% endif %}
  {# No font preloads, on purpose (owner call 2026-09-07): preloading the four
     woff2 made Lighthouse's simulated LCP jump to 5.2 s (bandwidth competition
     in the simulator; real throttled LCP stayed at FCP). The CLS fix is the
     metric-matched fallback faces in fonts.css instead. #}
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/main.css">
  <meta name="theme-color" content="#081830">
  {% include "partials/jsonld-org.njk" %}
</head>
