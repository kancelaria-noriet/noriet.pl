<div class="card-grid card-grid--offer">
  {% for col in nav.offerGrid %}
  <nav class="offer-col" aria-label="Oferta – {{ col.title }}">
    <h3>{{ col.title }}</h3>
    <ul>
      {% for item in col.items %}
      <li><a href="{{ item.url }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </nav>
  {% endfor %}
</div>
